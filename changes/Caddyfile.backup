claudeapilocal.satoshitech.xyz {
    reverse_proxy localhost:3008
    
    # 启用压缩
    encode gzip
    
    # 设置安全头
    header {
        X-Frame-Options DENY
        X-Content-Type-Options nosniff
        X-XSS-Protection "1; mode=block"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    }
    
    # 健康检查日志
    log {
        output file /var/log/caddy/claudeapilocal.log
        format json
    }
}

# 保留原有域名配置以备后续迁移
claudeapi.satoshitech.xyz {
    reverse_proxy localhost:3008
    
    encode gzip
    header {
        X-Frame-Options DENY
        X-Content-Type-Options nosniff
        X-XSS-Protection "1; mode=block"
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    }
    
    log {
        output file /var/log/caddy/claudeapi.log
        format json
    }
}
